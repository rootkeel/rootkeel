# Rootkeel server settings for one environment (single host, Docker Compose).
# Copy this file to a private path on the server, for example /etc/rootkeel/rootkeel.env,
# and replace every example value. Then, from a checkout of the release you run:
#   sudo scripts/prepare.sh /etc/rootkeel/rootkeel.env
#   sudo scripts/compose.sh /etc/rootkeel/rootkeel.env up -d
# docs/install.md (step 6) says what to put in each setting, and docs/configuration.md describes
# every setting. Values are literal: no $ interpolation. No secret goes in this file: prepare.sh
# generates the owner credential and the database key in RT_STATE_DIR.

# A short name for this server. It names the Compose project (rootkeel-<name>) and labels
# machine credentials.
RT_ENVIRONMENT=prod
# The hostname for the API, rt and browsers, and the hostname the agents' tunnel dials.
# Both point at this host. The owner's terminal pages are served on owner.<RT_PUBLIC_HOST>,
# so the TLS certificate must cover RT_PUBLIC_HOST, owner.RT_PUBLIC_HOST and RT_RELAY_HOST.
RT_PUBLIC_HOST=term.example.com
RT_RELAY_HOST=term-relay.example.com
# The port clients use for both hostnames, and the address:port this host binds for HTTPS.
RT_PUBLIC_PORT=443
RT_HTTPS_BIND=0.0.0.0:443
# Private state: the owner credential, the database and its encryption key. Outside the checkout.
RT_STATE_DIR=/srv/rootkeel/prod
# The TLS certificate (full chain: the certificate, then its intermediates) and its unencrypted
# key, for example certbot's /etc/letsencrypt/live/<RT_PUBLIC_HOST>/fullchain.pem and privkey.pem.
# Leave both unset to use <state>/certs/server.{crt,key}, where prepare.sh --lab-ca writes a lab CA.
RT_TLS_CERT_FILE=/etc/rootkeel/tls/fullchain.pem
RT_TLS_KEY_FILE=/etc/rootkeel/tls/privkey.pem
# Strict-Transport-Security max-age in seconds. Start short while hostnames may still change.
RT_HSTS_MAX_AGE=31536000
# Session grants stay open until revoked. Optional administrative time limits, in
# seconds (0: none): end a grant after this long without terminal input, or this
# long after it was issued.
#RT_GRANT_IDLE_TIMEOUT=0
#RT_GRANT_MAX_LIFETIME=0
# Images, each pinned to one build: a version tag or a digest, never a moving tag such as latest.
# Set RT_REQUIRE_IMAGE_DIGEST=true to accept digests only. When the release you run lists its
# published images (ghcr.io/rootkeel/broker and ghcr.io/rootkeel/relay) in its notes, set the two
# references below to those digests. Otherwise build the broker and relay on this host with
# `scripts/build-images.sh rootkeel-local 0.1.0`, which produces the two references below.
RT_REQUIRE_IMAGE_DIGEST=false
RT_BROKER_IMAGE=rootkeel-local/broker:0.1.0
RT_RELAY_IMAGE=rootkeel-local/relay:0.1.0
RT_PROXY_IMAGE=nginx:1.30.1-alpine@sha256:c819f83c54b0361f5557601bf5eb4943d09360e7a7fdf426afc466570f45874d
