# Rendered at container start from RT_PUBLIC_HOST, RT_RELAY_HOST and RT_HSTS_MAX_AGE.
# Only these server names are routed; any other Host/SNI gets 421 from the default server.
server {
    listen 443 ssl;
    server_name ${RT_RELAY_HOST};
    # The agent tunnel upgrade path only; frps' vhost and admin surfaces stay private.
    location = /~!frp {
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        set $relay relay:7000;
        proxy_pass http://$relay;
    }
    location / { return 404; }
}
server {
    listen 443 ssl;
    # The public host and the owner's terminal host (owner.<public host>).
    server_name ${RT_PUBLIC_HOST} owner.${RT_PUBLIC_HOST};
    add_header Strict-Transport-Security "max-age=${RT_HSTS_MAX_AGE}" always;
    location / {
        proxy_set_header Host $http_host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        set $broker broker:8080;
        proxy_pass http://$broker;
    }
}
